gcpProjectNumber: {{ requiredEnv "GCP_PROJECT_NUMBER" | quote }}
gcpProjectId: {{ requiredEnv "GCP_PROJECT_ID" | quote }}
gcpZone: {{ .Values.gcpZone | quote }}
domain: {{ .Values.domain }}
environment: {{ .Values.environment }}
github:
  username: {{ .Values.registryUsername | quote }}
  repoUrl: https://github.com/{{ .Values.githubRepository }}
