global:
  domain: {{ .Values.argocd.domainPrefix }}.{{ .Values.domain }}

configs:
  params:
    server.insecure: true

server:
  httproute:
    enabled: true
    hostnames:
      - {{ .Values.argocd.domainPrefix }}.{{ .Values.domain }}
    parentRefs:
      - name: external-http
        namespace: cluster-init
        sectionName: https
