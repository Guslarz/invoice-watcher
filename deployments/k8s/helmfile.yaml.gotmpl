helmDefaults:
  wait: true
  timeout: 300

environments:
  dev:
    values:
      - environments/dev.yml.gotmpl
---
releases:
  - name: cluster-init
    namespace: cluster-init
    chart: ./cluster-init
    version: 0.2.0
    values:
      - values/cluster-init.yml.gotmpl
    needs:
      - cert-manager/cert-manager
      - origin-ca-issuer/origin-ca-issuer
      - argocd/argocd
      - external-secrets/external-secrets
  - name: argocd
    namespace: argocd
    createNamespace: true
    chart: oci://ghcr.io/argoproj/argo-helm/argo-cd
    version: 10.3.0
    values:
      - values/argocd.yml.gotmpl
  - name: cert-manager
    namespace: cert-manager
    chart: oci://quay.io/jetstack/charts/cert-manager
    version: 1.21.2
    values:
      - crds:
          enabled: true
  - name: origin-ca-issuer
    namespace: origin-ca-issuer
    chart: oci://ghcr.io/cloudflare/origin-ca-issuer-charts/origin-ca-issuer
    version: 0.6.9
    needs:
      - cert-manager/cert-manager
    values:
        - values/origin-ca-issuer.yml
    hooks:
      - events: [ "preapply" ]
        showlogs: true
        kubectlApply:
          filename: "https://raw.githubusercontent.com/cloudflare/origin-ca-issuer/v0.14.4/deploy/crds/cert-manager.k8s.cloudflare.com_originissuers.yaml"
      - events: [ "preapply" ]
        showlogs: true
        kubectlApply:
          filename: "https://raw.githubusercontent.com/cloudflare/origin-ca-issuer/v0.14.4/deploy/crds/cert-manager.k8s.cloudflare.com_clusteroriginissuers.yaml"
  - name: external-secrets
    namespace: external-secrets
    chart: oci://ghcr.io/external-secrets/charts/external-secrets
    version: 2.12.0
    values:
      - installCRDs: true
