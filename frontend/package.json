{
  "name": "invoice-watcher-frontend",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "build": "pnpm build:ui && ng build registration && ng build catalogue",
    "build:ui": "ng build ui",
    "start": "ng serve registration --host 127.0.0.1 --proxy-config proxy.json",
    "test": "playwright test",
    "check": "node scripts/check-tokens.mjs && pnpm build && pnpm test",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.65.0",
    "ng-packagr": "22.2.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
