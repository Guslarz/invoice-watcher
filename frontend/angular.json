{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "ui": {
      "projectType": "library",
      "root": "libs/ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "libs/ui/ng-package.json",
            "tsConfig": "libs/ui/tsconfig.lib.json"
          }
        }
      }
    },
    "registration": {
      "projectType": "application",
      "root": "apps/user-registration",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/user-registration/src/main.ts",
            "index": "apps/user-registration/src/index.html",
            "tsConfig": "apps/user-registration/tsconfig.app.json",
            "outputPath": "dist/registration",
            "styles": [
              "libs/ui/tokens/tokens.css",
              "apps/user-registration/src/styles.scss"
            ],
            "outputHashing": "all",
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "700kB",
                "maximumError": "1MB"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "registration:build"
          }
        }
      }
    },
    "catalogue": {
      "projectType": "application",
      "root": "libs/ui",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "libs/ui/catalogue/main.ts",
            "index": "libs/ui/catalogue/index.html",
            "tsConfig": "libs/ui/tsconfig.catalogue.json",
            "outputPath": "dist/catalogue",
            "styles": [
              "libs/ui/tokens/tokens.css",
              "libs/ui/catalogue/styles.scss"
            ],
            "outputHashing": "all",
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "700kB",
                "maximumError": "1MB"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "catalogue:build"
          }
        }
      }
    }
  }
}
