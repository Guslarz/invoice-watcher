{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(scripts/verify.sh)",
      "Bash(scripts/check-docs.sh)",
      "Bash(scripts/worktree.sh *)",
      "Bash(git add *)",
      "Bash(git fetch *)",
      "Bash(git rebase origin/master)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/scripts/worktree.sh\" hook-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/scripts/worktree.sh\" hook-remove"
          }
        ]
      }
    ]
  }
}
